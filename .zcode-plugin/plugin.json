{
  "name": "deepseek-web-plugin",
  "version": "0.2.1",
  "description": "把 DeepSeek 联网搜索装进任何 MCP 兼容的编码 agent",
  "mcpServers": {
    "deepseek-web": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server.mjs"],
      "env": {
        "DEEPSEEK_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "userConfig": {
    "api_key": {
      "type": "string",
      "default": "",
      "sensitive": true,
      "description": "DeepSeek API Key（sk- 开头）。留空则需在 config.json 用同名条目以 env 注入。"
    }
  }
}
